# Part 3: Ingestion Pipeline Configuration
# Copy this file to terraform.tfvars and update with your values

# Region for Lambda, API Gateway, IAM, etc. Should match .env DEFAULT_AWS_REGION
# and the region used for SageMaker (Part 2).
aws_region = "eu-west-1"

# Only if the alex-vectors bucket already exists in a *different* region than
# aws_region (terraform would otherwise get S3 PermanentRedirect / 301 on plan):
# s3_vectors_region = "us-east-1"
# Discover with: aws s3api get-bucket-location --bucket alex-vectors-<account_id>

# SageMaker endpoint name from Part 2
# This should be "alex-embedding-endpoint" if you didn't change it
sagemaker_endpoint_name = "alex-embedding-endpoint"